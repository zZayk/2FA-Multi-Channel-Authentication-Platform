# =============================================================================
# 2FA Multi-Channel Authentication Platform — environment variables (example)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — only `.env.example` lives in git.
# Production secrets must come from a secret manager (Vault / AWS SM / SOPS),
# not from a checked-in file.
# =============================================================================

# --- Meta -----------------------------------------------------------------
ENVIRONMENT=dev
APP_NAME=2FA Multi-Channel Authentication Platform
APP_VERSION=0.1.0

# --- Security -------------------------------------------------------------
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Postgres) --------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# SQLAlchemy async URL — must use the `+asyncpg` driver
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# --- Redis ----------------------------------------------------------------
# DB 0 = app cache (OTPs, rate limit), DB 1 = Celery broker, DB 2 = Celery results
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- OTP lifecycle --------------------------------------------------------
OTP_TTL_SECONDS=300
MAX_OTP_ATTEMPTS=5
OTP_CODE_LENGTH=6

# --- TunisiaSMS channel ---------------------------------------------------
TUNISIASMS_API_URL=https://api.tunisiasms.tn/v1
TUNISIASMS_API_KEY=
TUNISIASMS_SENDER_ID=L2T-2FA

# --- Email channel (SMTP) -------------------------------------------------
# In dev, run a local MailHog (port 1025) or set these to SendGrid creds.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@l2t.tn
EMAIL_USE_TLS=false

# --- Anti-abuse rules -----------------------------------------------------
ABUSE_RULE_MAX_PER_HOUR=10
ABUSE_RULE_MAX_PER_DAY=50
