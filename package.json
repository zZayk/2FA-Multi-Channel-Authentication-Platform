{
  "name": "2fa-multi-channel-auth-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Tooling root: husky + commitlint for conventional commits across backend/frontend.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"],
    "rules": {
      "body-max-line-length": [1, "always", 200],
      "footer-max-line-length": [1, "always", 200],
      "subject-case": [0],
      "scope-enum": [0],
      "header-max-length": [2, "always", 100]
    }
  }
}
